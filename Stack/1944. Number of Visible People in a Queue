Time: O(n)
Space: O(n)

class Solution:
    def canSeePersonsCount(self, heights: List[int]) -> List[int]:
        n = len(heights)
        answer = [0] * n
        stack = []

        for i in range(n-1, -1, -1):
            while stack and heights[i] > stack[-1]:
                stack.pop()
                answer[i] += 1
            # Current person can also see the first taller person
            if stack:
                answer[i] += 1

            stack.append(heights[i])

        return answer
