Time: O(m * n) m rows
Space: O(n)

The histogram algorithm is O(n) because:
Each bar is pushed onto the stack once.
Each bar is popped from the stack once.

class Solution:
    def maximalRectangle(self, matrix: List[List[str]]) -> int:
        if not matrix:
            return 0
        cols = len(matrix[0])
        heights = [0] * cols
        max_area = 0
        
        for row in matrix:
            for col in range(cols):
                if row[col] == "1":
                    heights[col] += 1
                else:
                    heights[col] = 0
            max_area = max(max_area, self.largestRectangleArea(heights))

        return max_area

    
    def largestRectangleArea(self, heights):
        stack = []
        max_area = 0

        for i, height in enumerate(heights):
            start = i
            while stack and height < stack[-1][1]:
                index, old_height = stack.pop()
                width = i - index
                area = width * old_height
                max_area = max(max_area, area)

                start = index
            stack.append((start, height))

        n = len(heights)
        while stack:
            index, height = stack.pop()
            width = n - index
            area = width * height
            max_area = max(max_area, area)

        return max_area
