Time: O(n^3)
Space: O(1)

class Solution:
    def fourSum(self, nums: list[int], target: int) -> list[list[int]]:
        nums.sort()
        n = len(nums)
        res = []

        for i in range(n-3):
            if i > 0 and nums[i] == nums[i-1]:
                continue
            for j in range(i+1, n-2):
                # skip duplicate j
                if j > i+1 and nums[j] == nums[j-1]:
                    continue
                
                l = j+1
                r = n-1

                while l < r:
                    total = nums[l] + nums[r] + nums[i] + nums[j]
                    if total == target:
                        res.append([nums[l], nums[r], nums[i], nums[j]])
                        l += 1
                        r -= 1

                        # Skip duplicate l
                        while l < r and nums[l] == nums[l-1]:
                            l += 1
                        while l < r and nums[r] == nums[r+1]:
                            r -= 1
                    
                    elif total < target:
                        l += 1
                    else:
                        r -= 1
        return res
