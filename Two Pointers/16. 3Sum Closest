Time: O(n^2)
Space: O(1)

Time: O(n²)

Sorting: O(n log n)
Each i performs a two-pointer scan: O(n)
Overall: O(n²)

Extra space: O(1), excluding the sorting implementation's internal space.

class Solution:
    def threeSumClosest(self, nums: list[int], target: int) -> int:
        nums.sort()
        n = len(nums)

        closet = nums[0] + nums[1] + nums[2]

        for i in range(n-2):
            if i > 0 and nums[i] == nums[i-1]:
                continue
            
            l = i + 1
            r = n - 1

            while l < r:
                total = nums[i] + nums[l] + nums[r]

                if abs(total - target) < abs(closet - target):
                    closet = total

                if total < target:
                    l += 1
                elif total > target:
                    r -= 1
                else:
                    return target
        
        return closet
