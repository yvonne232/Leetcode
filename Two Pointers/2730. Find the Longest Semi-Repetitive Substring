Time: O(n)
Space: O(1)

class Solution:
    def longestSemiRepetitiveSubstring(self, s: str) -> int:
        l = 0
        max_len = 0
        count = 0
        for r in range(len(s)):
            if r > 0 and s[r] == s[r-1]:
                count += 1

            while count > 1:
                if s[l] == s[l+1]:
                    count -= 1
                l += 1

            max_len = max(max_len, r-l+1)

        return max_len
