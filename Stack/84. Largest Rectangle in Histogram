Time: O(n)
Space: O(n)

class Solution:
    def largestRectangleArea(self, heights: List[int]) -> int:
        stack = []  # start, height
        max_area = 0

        for i, height in enumerate(heights):
            start = i
            while stack and stack[-1][1] > height:
                index, old_height = stack.pop()
                width = i - index
                area = width * old_height
                max_area = max(max_area, area)

                start = index
            
            stack.append((start, height))

        # Bars still in the stack never found a shorter baR on their right, so they can extend to the end
        n = len(heights)
        while stack:
            index, height = stack.pop()
            width = n - index
            area = width * height
            max_area = max(max_area, area)

        return max_area
