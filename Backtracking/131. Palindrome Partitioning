Time: 2^(n-1) * n
Space: O(n)

At each position between characters, we can either:
Cut
Don't cut

For a string of length n, there are n - 1 possible cut positions.
So 2^(n-1)

class Solution:
    def partition(self, s: str) -> List[List[str]]:
        res = []
        path = []

        def isPalindrome(left, right):
            while left < right:
                if s[left] != s[right]:
                    return False
                
                left += 1
                right -= 1
            return True

        def backtrack(start):
            if start == len(s):
                res.append(path.copy())
                return
            
            for end in range(start, len(s)):
                if not isPalindrome(start, end):
                    continue
                path.append(s[start:end+1])
                backtrack(end+1)
                path.pop()

        backtrack(0)
        return res
