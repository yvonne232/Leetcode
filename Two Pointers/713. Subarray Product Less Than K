Time: O(n)
Space: O(1)

class Solution:
    def numSubarrayProductLessThanK(self, nums: list[int], k: int) -> int:
        product = 1
        l = 0
        count = 0

        if k <= 1:
            return 0
            
        for r in range(len(nums)):
            product *= nums[r]

            while product >= k:
                product //= nums[l]
                l += 1
            
            count += r-l+1

        return count


