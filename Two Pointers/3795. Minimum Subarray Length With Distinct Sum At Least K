Time: O(n)
Space: O(n) The count dictionary

class Solution:
    def minLength(self, nums: List[int], k: int) -> int:
        l = 0
        total = 0
        count = {}
        min_len = float("inf")
        for r in range(len(nums)):
            if count.get(nums[r], 0) == 0:
                total += nums[r]
            count[nums[r]] = count.get(nums[r], 0) + 1
            while total >= k:
                min_len = min(min_len, r-l+1)
                count[nums[l]] -= 1
                if count[nums[l]] == 0:
                    total -= nums[l]

                l += 1
        
        return min_len if min_len != float("inf") else -1
