Time: O(n)
Space: O(1)

class Solution:
    def maxSubarrayLength(self, nums: List[int], k: int) -> int:
        max_len = 0
        l = 0
        count = {}

        for r in range(len(nums)):
            count[nums[r]] = count.get(nums[r], 0) + 1
            while count[nums[r]] > k:
                count[nums[l]] -= 1
                l += 1

            max_len = max(max_len, r-l+1)

        return max_len
