Time: O(n!)
Therefore, the number of choices decreases:
Row 0: n choices
Row 1: n-1 choices
Row 2: n-2 choices
...
Row n-1: 1 choice
This gives approximately
n × (n-1) × (n-2) × ... × 1 = n!
Space: recursion O(n)


class Solution:
    def totalNQueens(self, n: int) -> int:
        columns = set()
        positive_diagonals = set()
        negative_diagonals = set()

        def backtrack(row):
            if row == n:
                return 1
            
            count = 0

            for col in range(n):
                if (col in columns or row+col in positive_diagonals or row-col in negative_diagonals):
                    continue
                
                columns.add(col)
                positive_diagonals.add(row + col)
                negative_diagonals.add(row - col)

                count += backtrack(row+1)

                columns.remove(col)
                positive_diagonals.remove(row + col)
                negative_diagonals.remove(row - col)
            
            return count
        
        return backtrack(0)


So when all rows have queens:
if row == n:
    return 1
