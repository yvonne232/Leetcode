Time: O(n)
Space: O(k)

class Solution:
    def maxSlidingWindow(self, nums: List[int], k: int) -> List[int]:
        q = deque()
        result = []

        for i in range(len(nums)):
            while q and q[0] < i-k+1:
                q.popleft()
            
            # decreasing queue
            while q and nums[i] >= nums[q[-1]]:
                q.pop()
            
            q.append(i)

            if i >= k-1: # one full window
                result.append(nums[q[0]])
            
        return result
