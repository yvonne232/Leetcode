Initial	Empty	3	No	4
r = 0	   Q	  2	No	4
r = 1	   QQ	  1	Yes	2
Shrinkl	  Q	  2	No	2
r = 2  	QQ	  1	Yes	2
Shrinkl	Q	   2	No	2
r = 3	  QW	 2	No	2
