Time complexity: O(k * C9_k)
Space complexity: O(k) * m  if there are m valid combinations, the output space is:

class Solution:
    def combinationSum3(self, k: int, n: int) -> List[List[int]]:
        res = []
        path = []

        def backtrack(start, current_sum):
            if len(path) == k:
                if current_sum == n:
                    res.append(path.copy())
                return

            for num in range(start, 10):
                if current_sum + num > n:
                    break

                path.append(num)
                backtrack(num+1, current_sum+num)
                path.pop()

        backtrack(1, 0)

        return res
