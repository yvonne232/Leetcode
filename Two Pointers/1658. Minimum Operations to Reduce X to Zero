Time: O(n)
Space: O(1)

class Solution:
    def minOperations(self, nums: list[int], x: int) -> int:
        target = sum(nums) - x
        l = 0
        total = 0
        max_len = -1

        if target < 0:
            return -1
        for r in range(len(nums)):
            total += nums[r]
            while total > target:
                total -= nums[l]
                l += 1

            if total == target:
                max_len = max(max_len, r-l+1)
        
        if max_len == -1:
            return -1

        return len(nums) - max_len
